# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored. NEVER commit real secrets.
# For production use: npx wrangler secret put <NAME>

# Local app URL (overrides the production APP_URL in wrangler.jsonc)
APP_URL=http://localhost:5173

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# 32 random bytes, base64 encoded. Used to encrypt Google refresh tokens (AES-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Id stored inside every ciphertext (change it when you rotate the key). Default: k1
# TOKEN_ENCRYPTION_KEY_ID=k1
# Only during key rotation: the OLD key as "<old id>:<old base64 key>" so old tokens still decrypt.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=k1:BASE64_OLD_KEY

# Optional: random string used to hash IP addresses in audit logs. Without it, IPs are not stored.
# AUDIT_HASH_SALT=

# PageSpeed Insights API key (Google Cloud Console -> Credentials -> API key)
PAGESPEED_API_KEY=

# Turnstile secret. The value below is Cloudflare's official "always passes" test key for local dev.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------- Phase 2 / 3 (optional; features show "not configured" until set) ----------------
# Places API (New) key, restricted to "Places API (New)". Requires billing on the Google Cloud project.
# PLACES_API_KEY=
# Cloud Natural Language API key, restricted to "Cloud Natural Language API". Requires billing.
# NATURAL_LANGUAGE_API_KEY=
# Google Ads: no developer token needed (sunset Sep 2026). Access comes from the Google Cloud project (Explorer level).
# Optional manager account id (digits) used as login-customer-id
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Google Ads REST API version (default v26). Update when Google sunsets versions.
# GOOGLE_ADS_API_VERSION=v26
